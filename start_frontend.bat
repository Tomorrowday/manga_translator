@echo off
echo =======================================
echo Запуск Фронтенда (Next.js) для Manga Translator
echo =======================================

:: Изолируем локальный трафик от системных прокси
set NO_PROXY=localhost,127.0.0.1
set no_proxy=localhost,127.0.0.1

:: Переходим в папку с фронтендом
cd manga_ui

:: Запускаем сервер разработки строго на порту 3000 хоста 127.0.0.1
npm run dev -- -p 3000 -H 127.0.0.1

pause